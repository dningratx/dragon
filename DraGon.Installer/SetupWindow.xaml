<Window x:Class="DraGon.Installer.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DraGon Setup Wizard — Installer Lingkungan Development Lokal (.dra)"
        Icon="pack://application:,,,/Assets/dragon-icon.ico"
        Width="750"
        Height="710"
        MinHeight="620"
        MinWidth="680"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17"
        Foreground="#F8FAFC">

    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <!-- 0: Header Banner -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <!-- 2: Scrollable Setup Options -->
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <!-- 4: Dedicated Installation Status & Progress (Always Visible) -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <!-- 6: Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Banner -->
        <Border Grid.Row="0"
                Background="#161F30"
                BorderBrush="#283548"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48"
                        Height="48"
                        CornerRadius="12"
                        Background="#050B18"
                        BorderBrush="#FF6B35"
                        BorderThickness="1"
                        ClipToBounds="True"
                        Margin="0,0,14,0">
                    <Image Source="pack://application:,,,/Assets/dragon-icon.png"
                           Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Dra" FontSize="22" FontWeight="ExtraBold" Foreground="#F8FAFC" />
                        <TextBlock Text="Gon" FontSize="22" FontWeight="ExtraBold" Foreground="#FF6B35" />
                        <TextBlock Text=" Setup Wizard v1.0.0" FontSize="16" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="6,0,0,2" />
                    </StackPanel>
                    <TextBlock Text="Installer Mandiri Siap Pakai (Apache 2.4, PHP 8.3, MariaDB 11.4, Composer, Node.js, phpMyAdmin)"
                               FontSize="12"
                               Foreground="#94A3B8"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Setup Content (Scrollable if height is constrained) -->
        <Border Grid.Row="2"
                Background="#161F30"
                BorderBrush="#283548"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="20,16">
                <StackPanel>
                    <TextBlock Text="1. Lokasi Folder Aplikasi Custom (Application Folder)"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Pilih atau ketik lokasi folder aplikasi custom tempat DraGon dan seluruh runtime dipasang:"
                               FontSize="11.5"
                               Foreground="#94A3B8"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallPathTextBox"
                                 Grid.Column="0"
                                 Background="#0F172A"
                                 Foreground="#F8FAFC"
                                 BorderBrush="#283548"
                                 BorderThickness="1"
                                 Padding="10,6"
                                 FontSize="13"
                                 TextChanged="InstallPathTextBox_OnTextChanged" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="2"
                                Content="Pilih Folder Custom..."
                                Background="#243247"
                                Foreground="#F8FAFC"
                                BorderBrush="#334155"
                                Padding="14,6"
                                Cursor="Hand"
                                Click="BrowseButton_OnClick" />
                    </Grid>

                    <TextBlock Text="2. Lokasi Folder Workspace Proyek (Custom Project Folder)"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkspacePathTextBox"
                                 Grid.Column="0"
                                 Background="#0F172A"
                                 Foreground="#F8FAFC"
                                 BorderBrush="#283548"
                                 BorderThickness="1"
                                 Padding="10,6"
                                 FontSize="13" />
                        <Button x:Name="BrowseWorkspaceButton"
                                Grid.Column="2"
                                Content="Pilih Workspace..."
                                Background="#243247"
                                Foreground="#F8FAFC"
                                BorderBrush="#334155"
                                Padding="14,6"
                                Cursor="Hand"
                                Click="BrowseWorkspaceButton_OnClick" />
                    </Grid>

                    <!-- Offline Bundle Info Banner -->
                    <Border Background="#0F2922"
                            BorderBrush="#10B981"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12,8"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="✓ Paket Mandiri Siap Pakai (100% Offline)"
                                       FontSize="12"
                                       Foreground="#10B981"
                                       FontWeight="Bold"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="Paket runtime esensial (Apache 2.4, PHP 8.3 LTS, MariaDB 11.4, Composer, Node.js, phpMyAdmin) sudah terbundel di dalam installer ini. Paket atau versi lain (Nginx, PHP 8.4/8.2, MySQL, PostgreSQL) dapat diunduh kapan saja via tab 'Packages &amp; Installer'!"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Foreground="#A7F3D0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="3. Opsi Pintasan &amp; Lingkungan"
                               FontSize="13.5"
                               FontWeight="Bold"
                               Margin="0,0,0,6" />

                    <CheckBox x:Name="DesktopShortcutCheckBox"
                              IsChecked="True"
                              Foreground="#F8FAFC"
                              FontSize="12"
                              Margin="0,0,0,6"
                              Content="Buat pintasan (shortcut) DraGon di Desktop" />

                    <CheckBox x:Name="StartMenuShortcutCheckBox"
                              IsChecked="True"
                              Foreground="#F8FAFC"
                              FontSize="12"
                              Margin="0,0,0,6"
                              Content="Buat pintasan DraGon di Start Menu Windows" />

                    <CheckBox x:Name="InitWorkspaceCheckBox"
                              IsChecked="True"
                              Foreground="#F8FAFC"
                              FontSize="12"
                              Margin="0,0,0,6"
                              Content="Pasang seluruh paket runtime &amp; daftarkan path binary ke Windows PATH untuk Command Prompt" />

                    <CheckBox x:Name="LaunchAfterInstallCheckBox"
                              IsChecked="True"
                              Foreground="#F8FAFC"
                              FontSize="12"
                              Margin="0,0,0,4"
                              Content="Jalankan DraGon secara otomatis setelah instalasi selesai" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 4: Dedicated Installation Status Panel (Always Visible at Bottom) -->
        <Border Grid.Row="4"
                Background="#161F30"
                BorderBrush="#283548"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,11">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Status Proses Instalasi"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="#F8FAFC" />
                    <TextBlock x:Name="PercentTextBlock"
                               Text="Siap"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#10B981" />
                </Grid>

                <ProgressBar x:Name="InstallProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="10"
                             Background="#0F172A"
                             Foreground="#10B981"
                             Margin="0,0,0,6" />

                <TextBlock x:Name="StatusTextBlock"
                           Text="Siap memasang DraGon beserta seluruh runtime ke folder aplikasi custom Anda."
                           FontSize="11.5"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="#38BDF8" />
            </StackPanel>
        </Border>

        <!-- Bottom Action Buttons -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="UninstallButton"
                    Grid.Column="0"
                    Content="Hapus Instalasi (Uninstall)"
                    Background="#2D161B"
                    Foreground="#EF4444"
                    BorderBrush="#EF4444"
                    BorderThickness="1"
                    Padding="14,8"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="UninstallButton_OnClick" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="InstallButton"
                        Content="Pasang DraGon Sekarang (Install)"
                        Background="#FF6B35"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="22,9"
                        FontSize="13.5"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="InstallButton_OnClick" />
                <Button x:Name="CloseButton"
                        Content="Tutup"
                        Background="#243247"
                        Foreground="#F8FAFC"
                        BorderBrush="#334155"
                        Padding="16,9"
                        Cursor="Hand"
                        Click="CloseButton_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
