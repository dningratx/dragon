<Window x:Class="DraGon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DraGon.Core.Models;assembly=DraGon.Core"
        mc:Ignorable="d"
        Title="DraGon — Lingkungan Development Lokal Windows (.dra)"
        Icon="pack://application:,,,/Assets/dragon-icon.ico"
        Width="760"
        Height="480"
        MinWidth="560"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="MainWindow_OnClosing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="125" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="8,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Identity Header -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="6"
                                Background="#050B18"
                                BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Margin="0,0,6,0">
                            <Image Source="pack://application:,,,/Assets/dragon-icon.png"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Dra"
                                           FontSize="16"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Gon"
                                           FontSize="16"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource AccentPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource CardAltBgBrush}"
                            CornerRadius="4"
                            Padding="5,2"
                            Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource StatusSuccessBrush}"
                                     Margin="0,0,5,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HostnameSuffixBadgeText}"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="2">
                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Dashboard}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◈" FontSize="12" Width="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Projects}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Projects">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontSize="12" Width="16" Foreground="{DynamicResource StatusInfoBrush}" />
                            <TextBlock Text="Projects" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Services}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Services">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="12" Width="16" Foreground="{DynamicResource StatusSuccessBrush}" />
                            <TextBlock Text="Services" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Packages}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Packages">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬡" FontSize="12" Width="16" Foreground="{DynamicResource StatusWarningBrush}" />
                            <TextBlock Text="Packages" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Settings}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☰" FontSize="12" Width="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Sidebar Actions (Compact) -->
                <StackPanel Grid.Row="3">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="💻 Terminal"
                            ToolTip="Buka terminal PowerShell dengan environment DraGon (PHP, Composer, dll)"
                            Command="{Binding OpenGlobalTerminalCommand}"
                            Padding="6,4"
                            FontSize="11"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="🌓"
                                ToolTip="Ganti tema gelap / terang"
                                Command="{Binding ToggleThemeQuickCommand}"
                                Padding="4,4"
                                FontSize="11" />
                        <Button Grid.Column="2"
                                Style="{StaticResource DangerButtonStyle}"
                                Content="⏻"
                                ToolTip="Keluar dari DraGon"
                                Click="ExitApplicationButton_OnClick"
                                Padding="4,4"
                                FontSize="11" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Action Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EnvironmentSummaryText}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ActivePortsSummaryText}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="🗄️ PMA"
                                ToolTip="Buka phpMyAdmin di browser"
                                Padding="6,3"
                                FontSize="10.5"
                                Command="{Binding OpenPhpMyAdminInBrowserCommand}"
                                Margin="0,0,4,0" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="🐬 DB"
                                ToolTip="Buka HeidiSQL Database Manager GUI"
                                Padding="6,3"
                                FontSize="10.5"
                                Command="{Binding OpenHeidiSqlCommand}"
                                Margin="0,0,4,0" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="🐘 PHP"
                                ToolTip="Buka phpinfo() di browser"
                                Padding="6,3"
                                FontSize="10.5"
                                Command="{Binding OpenPhpInfoInBrowserCommand}"
                                Margin="0,0,6,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="▶ Start"
                                ToolTip="Jalankan seluruh layanan utama (Web Server, PHP-CGI, MariaDB)"
                                Padding="8,3"
                                FontSize="10.5"
                                IsEnabled="{Binding CanStartAllServices}"
                                Command="{Binding StartAllServicesCommand}"
                                Margin="0,0,4,0" />
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Content="■ Stop"
                                ToolTip="Hentikan seluruh layanan yang sedang berjalan"
                                Padding="8,3"
                                FontSize="10.5"
                                IsEnabled="{Binding CanStopAllServices}"
                                Command="{Binding StopAllServicesCommand}"
                                Margin="0,0,4,0" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="🔄"
                                ToolTip="Muat ulang konfigurasi vhost &amp; restart layanan web aktif"
                                Padding="6,3"
                                FontSize="10.5"
                                IsEnabled="{Binding CanReloadServices}"
                                Command="{Binding ReloadServicesCommand}"
                                Margin="0,0,4,0" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="⟳"
                                ToolTip="Segarkan status layanan"
                                Padding="6,3"
                                FontSize="10.5"
                                Command="{Binding RefreshAllEnvironmentStatusCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Busy Indicator & Notification Banner -->
            <StackPanel Grid.Row="1" Margin="14,8,14,0">
                <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource StatusInfoSoftBrush}"
                        BorderBrush="{DynamicResource StatusInfoBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6"
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     IsIndeterminate="True"
                                     Width="80"
                                     Height="6"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BusyMessage}"
                                   FontWeight="Medium"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                </Border>

                <Border Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource CardAltBgBrush}"
                        BorderBrush="{Binding NotificationTone, Converter={StaticResource NotificationToneToBrush}}"
                        BorderThickness="2,1,1,1"
                        CornerRadius="6"
                        Padding="10,6"
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                                 Width="6"
                                 Height="6"
                                 VerticalAlignment="Top"
                                 Margin="0,5,0,0"
                                 Fill="{Binding NotificationTone, Converter={StaticResource NotificationToneToBrush}}" />
                        <StackPanel Grid.Column="1" Margin="8,0,10,0">
                            <TextBlock Text="{Binding NotificationTitle}"
                                       FontWeight="Bold"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding NotificationMessage}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="⚡ Hosts"
                                    ToolTip="Sinkronkan domain proyek ke file hosts Windows"
                                    Padding="8,4"
                                    Margin="0,0,6,0"
                                    Command="{Binding SyncAllDomainsToHostsCommand}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="✕"
                                    ToolTip="Tutup notifikasi"
                                    Padding="8,4"
                                    Command="{Binding DismissNotificationCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Update Available Alert Banner -->
                <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                        Background="#0D281E"
                        BorderBrush="{DynamicResource StatusSuccessBrush}"
                        BorderThickness="1.5"
                        CornerRadius="6"
                        Padding="10,8"
                        Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🚀" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AvailableUpdateManifest.Title, FallbackValue='Pembaruan Tersedia'}"
                                           FontWeight="Bold"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border Margin="8,0,0,0"
                                        Background="#103828"
                                        CornerRadius="4"
                                        Padding="5,1">
                                    <TextBlock Text="{Binding AvailableUpdateManifest.FormattedPatchSize, StringFormat='✨ Patch: {0}'}"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource StatusSuccessBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Pembaruan kecil tersedia! Hanya mengunduh file yang diperbarui tanpa mendownload ulang seluruh aplikasi atau runtime."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="⚡ Pasang Patch"
                                    ToolTip="Unduh dan pasang patch pembaruan langsung"
                                    Command="{Binding DownloadAndApplyPatchUpdateCommand}"
                                    IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource BoolInverter}}"
                                    Padding="10,5"
                                    Margin="0,0,6,0" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Rincian"
                                    ToolTip="Buka rincian pembaruan di menu Pengaturan"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Settings"
                                    Padding="8,5"
                                    Margin="0,0,6,0" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="✕"
                                    ToolTip="Sembunyikan pesan pembaruan ini"
                                    Command="{Binding DismissUpdateNoticeCommand}"
                                    Padding="8,5" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== SECTION VIEWS ==================== -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14,8,14,16">
                <Grid>

                    <!-- ==================== 1. DASHBOARD VIEW (COMPACT) ==================== -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Dashboard}">
                        <TextBlock Text="LAYANAN LOKAL"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding InstalledServices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ServiceState}">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,10,10" Padding="14,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="14.5"
                                                               FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource CardAltBgBrush}"
                                                        CornerRadius="10"
                                                        Padding="8,3"
                                                        VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7"
                                                                 Fill="{Binding Status, Converter={StaticResource ServiceStatusToBrush}}"
                                                                 Margin="0,0,5,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="0,8,0,10">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding PortDisplay}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StatusInfoBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding PidDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="6,0,0,0"
                                                            Visibility="{Binding HasActiveVersion, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="{Binding ActiveVersionToolTip}">
                                                        <TextBlock Text="{Binding ActiveVersionDisplay}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource ServiceStatusToBrush}}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding InstallationGuide}"
                                                           Visibility="{Binding IsMissingRuntime, Converter={StaticResource BoolToVis}}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource StatusWarningBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                                        Content="▶"
                                                        ToolTip="Mulai layanan"
                                                        Padding="10,4"
                                                        Margin="0,0,5,0"
                                                        IsEnabled="{Binding CanStart}"
                                                        Command="{Binding DataContext.StartSingleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="■"
                                                        ToolTip="Hentikan layanan"
                                                        Padding="10,4"
                                                        Margin="0,0,5,0"
                                                        IsEnabled="{Binding CanStop}"
                                                        Command="{Binding DataContext.StopSingleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="📁"
                                                        ToolTip="Buka folder runtime layanan"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.OpenServiceRuntimeFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ==================== 2. PROJECTS VIEW ==================== -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Projects}">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Daftar Proyek &amp; Domain Lokal"
                                           FontSize="18"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="+ Buat Proyek"
                                        ToolTip="Buat proyek baru langsung dengan ketik nama (Standar, Laravel, WordPress, Git)"
                                        Padding="8,4"
                                        Command="{Binding OpenAddProjectFormCommand}"
                                        Margin="0,0,5,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="📂 Impor"
                                        ToolTip="Pilih folder proyek lokal yang sudah ada"
                                        Padding="8,4"
                                        Command="{Binding BrowseAndAddProjectCommand}"
                                        Margin="0,0,5,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="🔍 Pindai"
                                        ToolTip="Pindai workspace DraGon"
                                        Padding="8,4"
                                        Command="{Binding ScanWorkspaceForProjectsCommand}"
                                        Margin="0,0,5,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="⚡ Hosts"
                                        ToolTip="Sinkronkan domain proyek ke hosts Windows (127.0.0.1)"
                                        Padding="8,4"
                                        Command="{Binding SyncAllDomainsToHostsCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- Local SSL Root CA Bar (Compact) -->
                        <Border Background="{DynamicResource CardAltBgBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding RootCaStatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource StatusSuccessBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="🔒 Trust CA"
                                            ToolTip="Pasang dan percayai DraGon Root CA di Windows Certificate Store"
                                            Padding="8,4"
                                            Margin="0,0,5,0"
                                            Command="{Binding TrustRootCaCommand}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="🔄 SSL"
                                            ToolTip="Perbarui seluruh sertifikat SSL proyek"
                                            Padding="8,4"
                                            Margin="0,0,5,0"
                                            Command="{Binding RegenerateAllSslCertificatesCommand}" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="📁 Certs"
                                            ToolTip="Buka folder sertifikat SSL"
                                            Padding="8,4"
                                            Command="{Binding OpenCertsFolderCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Add / Edit Project Form Card -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding IsProjectFormOpen, Converter={StaticResource BoolToVis}}"
                                BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                Margin="0,0,0,18">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Formulir Proyek &amp; Domain Lokal (.dra)"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="✕"
                                            ToolTip="Tutup formulir"
                                            Padding="6,2"
                                            Command="{Binding CancelProjectFormCommand}" />
                                </Grid>

                                <!-- Template / Tipe Proyek Selector -->
                                <Border Background="{DynamicResource CardAltBgBrush}"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding IsEditingExistingProject, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="PILIH TIPE / TEMPLATE PROYEK:"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <RadioButton Content="📁 Standar (PHP/Web)"
                                                         GroupName="NewProjType"
                                                         IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=Standard}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontSize="11.5"
                                                         FontWeight="SemiBold"
                                                         Margin="0,0,14,4" />
                                            <RadioButton Content="🔴 Laravel"
                                                         GroupName="NewProjType"
                                                         IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=Laravel}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontSize="11.5"
                                                         FontWeight="SemiBold"
                                                         Margin="0,0,14,4" />
                                            <RadioButton Content="🔵 WordPress"
                                                         GroupName="NewProjType"
                                                         IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=WordPress}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontSize="11.5"
                                                         FontWeight="SemiBold"
                                                         Margin="0,0,14,4" />
                                            <RadioButton Content="🐙 Git Clone"
                                                         GroupName="NewProjType"
                                                         IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=GitClone}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontSize="11.5"
                                                         FontWeight="SemiBold"
                                                         Margin="0,0,14,4" />
                                            <RadioButton Content="📂 Folder yang Ada"
                                                         GroupName="NewProjType"
                                                         IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=Existing}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontSize="11.5"
                                                         FontWeight="SemiBold"
                                                         Margin="0,0,14,4" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Git Clone URL Field (Only when GitClone is selected) -->
                                <StackPanel Visibility="{Binding FormProjectType, Converter={StaticResource StringEqualToVis}, ConverterParameter=GitClone}"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="URL Repositori Git" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding FormGitUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="https://github.com/username/repository.git" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nama Proyek (Langsung Buat Folder)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding FormProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding FormDomainLabelText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding FormProjectDomain, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Lokasi Folder Proyek (di Workspace)" FontSize="12" FontWeight="SemiBold" Margin="0,12,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding FormProjectFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih Folder Lain..."
                                            Command="{Binding BrowseProjectFolderForFormCommand}" />
                                </Grid>

                                <TextBlock Text="{Binding FormDetectedFrameworkHint}"
                                           FontSize="12"
                                           Foreground="{DynamicResource StatusInfoBrush}"
                                           Margin="0,8,0,10" />

                                <CheckBox IsChecked="{Binding FormEnableHttps}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,0,6"
                                          Content="Aktifkan HTTPS Lokal (https://*.dra) dan terbitkan sertifikat SSL lokal otomatis" />

                                <CheckBox IsChecked="{Binding FormAutoSyncHosts}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Margin="0,0,0,14"
                                          Content="Langsung daftarkan/perbarui domain .dra ke file hosts Windows (127.0.0.1) setelah menyimpan" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{Binding SaveProjectButtonText}"
                                            Command="{Binding SaveProjectFormCommand}"
                                            Padding="12,5"
                                            Margin="0,0,10,0" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Batal"
                                            Command="{Binding CancelProjectFormCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Search / Filter Box -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="340" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Cari nama proyek atau domain .dra..." />
                        </Grid>

                        <!-- Empty State in Projects View -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding HasFilteredProjects, Converter={StaticResource InverseBoolToVis}}"
                                Padding="30">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                                <TextBlock Text="Tidak Ada Proyek yang Ditampilkan"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Klik tombol '+ Pilih Folder Proyek' untuk menambahkan proyek PHP, Laravel, atau Node.js dari komputer Anda, atau klik 'Pindai Workspace' untuk memuat subfolder di dalam direktori workspace."
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,8,0,16" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="+ Tambah Proyek Sekarang"
                                        HorizontalAlignment="Center"
                                        Command="{Binding OpenAddProjectFormCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Full Project Cards List -->
                        <ItemsControl ItemsSource="{Binding FilteredProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ProjectItem}">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="16,14">
                                        <StackPanel>
                                            <!-- Row 0: Project Header (Name + Badges on Left, Launch Action on Right) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Title & Status Badges (WrapPanel prevents overflow) -->
                                                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,4" />
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="5"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,4">
                                                        <TextBlock Text="{Binding FrameworkBadgeText}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="5"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,4">
                                                        <TextBlock Text="{Binding ProtocolBadgeText}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="5"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,8,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8"
                                                                     Fill="{Binding DomainStatus, Converter={StaticResource DomainStatusToBrush}}"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DomainStatusText}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Right: Primary Launch Button -->
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Content="🌐 Buka Browser"
                                                        ToolTip="Buka domain proyek ini di browser"
                                                        Padding="12,6"
                                                        FontSize="12.5"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.OpenProjectInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>

                                            <!-- Row 1: Details & Management Toolbar -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Address, SSL, and Directory Path -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <WrapPanel Margin="0,0,0,4">
                                                        <TextBlock Text="Alamat:"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="0,0,6,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding PrimaryUrlDisplay}"
                                                                   FontSize="12.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource StatusInfoBrush}"
                                                                   Margin="0,0,12,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding SslStatusText}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}"
                                                                   Margin="0,0,12,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DocumentRoot, StringFormat='DocRoot: {0}'}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding FolderPath, StringFormat='Folder: {0}'}"
                                                               FontSize="11.5"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Right: Project Management Buttons -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="🔒 HTTPS"
                                                            ToolTip="Beralih protokol HTTPS (SSL Lokal) / HTTP Standar"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.ToggleProjectHttpsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="💻"
                                                            ToolTip="Buka terminal langsung di folder proyek ini"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.OpenProjectInTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="📁"
                                                            ToolTip="Buka folder proyek di File Explorer"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.OpenProjectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="✏"
                                                            ToolTip="Ubah domain atau konfigurasi proyek"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.OpenEditProjectFormCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource DangerButtonStyle}"
                                                            Content="🗑"
                                                            ToolTip="Hapus proyek ini dari daftar DraGon"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Command="{Binding DataContext.RemoveProjectFromListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ==================== 3. SERVICES VIEW (COMPACT) ==================== -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Services}">
                        <TextBlock Text="Layanan Lokal &amp; Multi-Versi"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <!-- Multi-PHP & Multi-Database Version Switcher & Direct Downloader Bar -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="16,14">
                            <StackPanel>
                                <!-- Section 1: PHP Version Switcher -->
                                <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Header & Info -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="🐘 PHP Version"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource CardBgBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActivePhpSummaryText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource StatusInfoBrush}" />
                                                </Border>
                                            </WrapPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="📦 Paket"
                                                    ToolTip="Buka menu Packages &amp; Installer untuk unduh versi PHP lain"
                                                    Padding="7,3"
                                                    FontSize="11"
                                                    Command="{Binding SelectSectionCommand}"
                                                    CommandParameter="Packages" />
                                        </Grid>

                                        <!-- Row 1: Selection Dropdown & Apply Action -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding PhpVersions}"
                                                      SelectedItem="{Binding SelectedPhpVersionCandidate}"
                                                      Padding="6,4"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="✓ Terapkan"
                                                    ToolTip="Terapkan dan aktifkan versi PHP ini"
                                                    Padding="10,4"
                                                    FontSize="11.5"
                                                    Command="{Binding ApplySelectedPhpVersionCommand}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Section 2: Database (MariaDB / MySQL) Version Switcher -->
                                <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Header & Info -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="🐬 Database (MariaDB / MySQL)"
                                                           FontSize="13.5"
                                                           FontWeight="Bold"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource CardBgBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActiveDatabaseSummaryText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource StatusSuccessBrush}" />
                                                </Border>
                                            </WrapPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="📦 Paket"
                                                    ToolTip="Buka menu Packages &amp; Installer untuk unduh versi Database lain"
                                                    Padding="7,3"
                                                    FontSize="11"
                                                    Command="{Binding SelectSectionCommand}"
                                                    CommandParameter="Packages" />
                                        </Grid>

                                        <!-- Row 1: Selection Dropdown & Apply Action -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding DatabaseVersions}"
                                                      SelectedItem="{Binding SelectedDatabaseVersionCandidate}"
                                                      Padding="6,4"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="✓ Terapkan"
                                                    ToolTip="Terapkan dan aktifkan versi Database ini"
                                                    Padding="10,4"
                                                    FontSize="11.5"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding ApplySelectedDatabaseVersionCommand}" />
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Content="⚡ Init Data"
                                                    ToolTip="Inisialisasi direktori data database jika belum ada"
                                                    Padding="8,4"
                                                    FontSize="11.5"
                                                    Command="{Binding InitializeMariaDbDatabaseCommand}" />
                                        </Grid>
                                    </Grid>
                                </Border>


                            </StackPanel>
                        </Border>

                        <!-- PHP Extension Manager Card -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="16,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Pengaturan Ekstensi PHP (php.ini Extensions Manager)"
                                                   FontSize="15"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="Centang atau hapus centang ekstensi PHP untuk langsung mengaktifkan/menonaktifkan pada php.ini (otomatis restart PHP FastCGI jika sedang berjalan)."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="✓ Aktifkan Rekomendasi Laravel"
                                                Padding="12,6"
                                                Margin="0,0,8,0"
                                                Command="{Binding EnableRecommendedPhpExtensionsCommand}" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Buka php.ini"
                                                Padding="12,6"
                                                Margin="0,0,8,0"
                                                Command="{Binding OpenActivePhpIniFileCommand}" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Folder ext"
                                                Padding="12,6"
                                                Command="{Binding OpenActivePhpExtFolderCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource CardAltBgBrush}"
                                        CornerRadius="7"
                                        Padding="12,10">
                                    <ItemsControl ItemsSource="{Binding PhpExtensions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:PhpExtensionItem}">
                                                <CheckBox Content="{Binding DisplayLabel}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          FontFamily="Consolas"
                                                          FontSize="12.5"
                                                          Margin="4,4"
                                                          Cursor="Hand"
                                                          Command="{Binding DataContext.TogglePhpExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding InstalledServices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ServiceState}">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="10" Height="10"
                                                                 Fill="{Binding Status, Converter={StaticResource ServiceStatusToBrush}}"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="16.5"
                                                                   FontWeight="Bold"
                                                                   Margin="0,0,10,0" />
                                                        <Border Background="{DynamicResource CardAltBgBrush}"
                                                                CornerRadius="5"
                                                                Padding="8,3"
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <Border Background="{DynamicResource CardAltBgBrush}"
                                                                CornerRadius="5"
                                                                Padding="8,3"
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding PortDisplay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource StatusInfoBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource CardAltBgBrush}"
                                                                CornerRadius="5"
                                                                Padding="8,3">
                                                            <TextBlock Text="{Binding PidDisplay}"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <Border Background="{DynamicResource CardAltBgBrush}"
                                                                CornerRadius="5"
                                                                Padding="8,3"
                                                                Margin="8,0,0,0"
                                                                Visibility="{Binding HasActiveVersion, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="{Binding ActiveVersionToolTip}">
                                                            <TextBlock Text="{Binding ActiveVersionDisplay}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding Status, Converter={StaticResource ServiceStatusToBrush}}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,4,0,4" />
                                                    <TextBlock Text="{Binding StatusMessage}"
                                                               FontSize="12.5"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />

                                                    <Border Background="{DynamicResource StatusWarningSoftBrush}"
                                                            BorderBrush="{DynamicResource StatusWarningBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="10,7"
                                                            Margin="0,8,0,0"
                                                            Visibility="{Binding IsMissingRuntime, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding InstallationGuide}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource StatusWarningBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                                            Content="▶"
                                                            ToolTip="Mulai layanan"
                                                            Padding="10,4"
                                                            Margin="0,0,5,0"
                                                            IsEnabled="{Binding CanStart}"
                                                            Command="{Binding DataContext.StartSingleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="■"
                                                            ToolTip="Hentikan layanan"
                                                            Padding="10,4"
                                                            Margin="0,0,5,0"
                                                            IsEnabled="{Binding CanStop}"
                                                            Command="{Binding DataContext.StopSingleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="📁"
                                                            ToolTip="Buka folder runtime layanan"
                                                            Padding="8,4"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.OpenServiceRuntimeFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="📄 Log"
                                                            ToolTip="Buka file log layanan"
                                                            Padding="8,4"
                                                            Command="{Binding DataContext.OpenServiceLogFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Background="{DynamicResource CardAltBgBrush}"
                                                    CornerRadius="6"
                                                    Padding="10,8"
                                                    Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ExecutablePath, TargetNullValue='Executable: (Belum terdeteksi di folder runtime)', StringFormat='Executable: {0}'}"
                                                               FontSize="11.5"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding ArgumentsSummary, TargetNullValue='Argumen: -', StringFormat='Argumen Proses: {0}'}"
                                                               FontSize="11.5"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Application & Process Log Panel -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Log Aktivitas &amp; Error Proses Lokal"
                                                   FontSize="15.5"
                                                   FontWeight="Bold" />
                                        <TextBlock Text="{Binding LogsFolderDisplay, StringFormat='Disimpan di: {0}'}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="📄 dragon.log"
                                                ToolTip="Buka file log utama DraGon"
                                                Padding="8,4"
                                                Command="{Binding OpenMainLogFileCommand}"
                                                Margin="0,0,5,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="📁 Logs"
                                                ToolTip="Buka folder log DraGon"
                                                Padding="8,4"
                                                Command="{Binding OpenLogsFolderCommand}"
                                                Margin="0,0,5,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="🧹 Bersihkan"
                                                ToolTip="Bersihkan tampilan log"
                                                Padding="8,4"
                                                Command="{Binding ClearLogViewCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource TerminalBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Height="200"
                                        Padding="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ApplicationLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontFamily="Consolas"
                                                               FontSize="11.5"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TerminalTextBrush}"
                                                               Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 4. PACKAGES VIEW ==================== -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Packages}">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Paket Runtime &amp; Installer Resmi"
                                           FontSize="18"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="🔄 Pindai"
                                        ToolTip="Pindai ulang runtime terpasang"
                                        Padding="8,4"
                                        Command="{Binding RescanRuntimesCommand}"
                                        Margin="0,0,5,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="📁 Runtime"
                                        ToolTip="Buka folder runtime DraGon"
                                        Padding="8,4"
                                        Command="{Binding OpenRuntimeBaseFolderCommand}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RuntimePackages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:RuntimePackageInfo}">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12,10">
                                        <StackPanel>
                                            <!-- Row 1: Header (Title & Badges on Left, Action Buttons on Right) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left: Package Title & Tags -->
                                                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="14.5"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,2" />
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,2">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StatusInfoBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,2">
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Right: Action Buttons (Tidy & Concise) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                                            Content="{Binding DownloadButtonText}"
                                                            ToolTip="{Binding DownloadButtonToolTip}"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Margin="0,0,5,0"
                                                            IsEnabled="{Binding CanDownloadAndInstall}"
                                                            Visibility="{Binding HasDirectArchiveUrl, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.DownloadAndInstallPackageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="🐬"
                                                            ToolTip="Buka HeidiSQL GUI"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Margin="0,0,5,0"
                                                            Visibility="{Binding Id, Converter={StaticResource StringEqualToVis}, ConverterParameter=heidisql}"
                                                            IsEnabled="{Binding IsAvailable}"
                                                            Command="{Binding DataContext.OpenHeidiSqlCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="📂 Impor"
                                                            ToolTip="Pilih file ZIP distribusi resmi secara manual"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Margin="0,0,5,0"
                                                            IsEnabled="{Binding CanInstallOrImport}"
                                                            Command="{Binding DataContext.ImportPackageZipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="🌐 Web"
                                                            ToolTip="{Binding WebsiteOrUpdateActionToolTip}"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Margin="0,0,5,0"
                                                            Command="{Binding DataContext.OpenPackageDownloadPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="📁"
                                                            ToolTip="Buka folder runtime paket ini di File Explorer"
                                                            Padding="8,4"
                                                            FontSize="11.5"
                                                            Command="{Binding DataContext.OpenPackageTargetFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Description / Instructions -->
                                            <TextBlock Text="{Binding InstallInstructions}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,6,0,6" />

                                            <!-- Row 2.5: Version Selection Dropdown -->
                                            <Border Background="{DynamicResource CardAltBgBrush}"
                                                    CornerRadius="6"
                                                    Padding="10,6"
                                                    Margin="0,0,0,6"
                                                    Visibility="{Binding HasMultipleVersions, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="🏷️ Versi:"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding AvailableVersions}"
                                                              SelectedItem="{Binding SelectedDownloadVersion, Mode=TwoWay}"
                                                              DisplayMemberPath="DisplayName"
                                                              FontSize="11.5"
                                                              Height="26"
                                                              VerticalContentAlignment="Center"
                                                              Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Border Visibility="{Binding IsSelectedVersionInstalled, Converter={StaticResource BoolToVis}}"
                                                                Background="{DynamicResource StatusSuccessSoftBrush}"
                                                                BorderBrush="{DynamicResource StatusSuccessBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,2">
                                                            <TextBlock Text="✔ Terpasang"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource StatusSuccessBrush}" />
                                                        </Border>
                                                        <Button Visibility="{Binding IsSelectedVersionInstalled, Converter={StaticResource InverseBoolToVis}}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Content="⬇ Pasang Versi Ini"
                                                                ToolTip="Unduh dan pasang versi yang dipilih langsung ke folder runtime DraGon"
                                                                Padding="8,3"
                                                                FontSize="11"
                                                                IsEnabled="{Binding CanInstallOrImport}"
                                                                Command="{Binding DataContext.DownloadAndInstallPackageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding SelectedDownloadVersion.DownloadUrl, TargetNullValue='', StringFormat='URL: {0}'}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>

                                            <!-- Row 3: Metadata & File Paths Box -->
                                            <Border Background="{DynamicResource CardAltBgBrush}"
                                                    CornerRadius="6"
                                                    Padding="12,8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <WrapPanel Grid.Row="0" Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding RecommendedVersion, StringFormat='Versi Rekomendasi: {0}'}"
                                                                   FontSize="11.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,0,16,2" />
                                                        <TextBlock Text="{Binding License, StringFormat='Lisensi: {0}'}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   Margin="0,0,16,2" />
                                                        <TextBlock Text="{Binding DetectedVersion, StringFormat='Versi Terdeteksi: {0}'}"
                                                                   Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}"
                                                                   Margin="0,0,16,2" />
                                                    </WrapPanel>

                                                    <StackPanel Grid.Row="1">
                                                        <TextBlock Text="{Binding TargetRuntimeFolder, StringFormat='Target Folder: {0}'}"
                                                                   FontSize="11"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding DetectedExecutablePath, StringFormat='✔ Executable Aktif: {0}'}"
                                                                   Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"
                                                                   FontSize="11"
                                                                   FontFamily="Consolas"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Row 4: Installation Progress Bar -->
                                            <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,10,0,0">
                                                <ProgressBar Minimum="0" Maximum="100"
                                                             Value="{Binding InstallProgressPercent}"
                                                             Height="8"
                                                             Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding InstallStatusMessage}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource StatusInfoBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ==================== 5. SETTINGS VIEW (COMPACT) ==================== -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Settings}">
                        <TextBlock Text="Pengaturan"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,12" />

                        <!-- Card 1: Custom App Folder, Workspace & Runtime Paths -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="1. Lokasi Folder Aplikasi Custom, Workspace &amp; Runtime"
                                           FontSize="15.5"
                                           FontWeight="Bold"
                                           Margin="0,0,0,12" />

                                <TextBlock Text="Folder Aplikasi DraGon (Custom Application Folder)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding SettingsApplicationFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih Folder Custom..."
                                            Command="{Binding BrowseApplicationFolderCommand}" />
                                    <Button Grid.Column="4"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Buka di Explorer"
                                            Command="{Binding OpenApplicationFolderCommand}" />
                                </Grid>

                                <TextBlock Text="Folder Workspace Proyek" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding SettingsWorkspacePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih Folder Lain..."
                                            Command="{Binding BrowseWorkspaceFolderCommand}" />
                                    <Button Grid.Column="4"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Buka di Explorer"
                                            Command="{Binding OpenWorkspaceFolderCommand}" />
                                </Grid>

                                <TextBlock Text="Lokasi Induk Runtime (Nginx, PHP, MariaDB, Apache, Node.js)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding SettingsRuntimeBasePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih Folder Lain..."
                                            Command="{Binding BrowseRuntimeFolderCommand}" />
                                    <Button Grid.Column="4"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Buka di Explorer"
                                            Command="{Binding OpenRuntimeBaseFolderCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Ports & Web Server -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="2. Konfigurasi Web Server, HTTPS Lokal &amp; Port"
                                           FontSize="15.5"
                                           FontWeight="Bold"
                                           Margin="0,0,0,12" />

                                <!-- Hostname Suffix Setting -->
                                <Border Background="{DynamicResource CardAltBgBrush}"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="240" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Akhiran Hostname / Domain Lokal (TLD)"
                                                       FontSize="13.5"
                                                       FontWeight="Bold" />
                                            <TextBlock Text="Bawaan (default) adalah '.dra'. Anda dapat mengubahnya menjadi '.test', '.local', '.lan', dll. Berlaku untuk saran otomatis proyek baru, pemindaian workspace, dan VirtualHost."
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Akhiran Hostname"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,0,0,4" />
                                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                     Text="{Binding SettingsHostnameSuffix, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="13"
                                                     Padding="10,6" />
                                            <TextBlock Text="Default: .dra (contoh: .dra, .test, .local)"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="2,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nginx HTTP" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsWebServerPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nginx HTTPS" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsWebServerHttpsPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Apache HTTP" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsApachePort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Apache HTTPS" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsApacheHttpsPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="8">
                                        <TextBlock Text="MariaDB/MySQL" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsDatabasePort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="10">
                                        <TextBlock Text="PHP FastCGI" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsPhpCgiPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,10" VerticalAlignment="Center">
                                    <TextBlock Text="Web Server Utama Saat 'Start All' &amp; Buka Browser:"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <ComboBox Width="180"
                                              ItemsSource="{Binding AvailableWebServers}"
                                              SelectedItem="{Binding SettingsPreferredWebServer}" />
                                </StackPanel>

                                <CheckBox IsChecked="{Binding SettingsEnableLocalHttps}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="13"
                                          Content="Aktifkan pembuatan sertifikat SSL lokal otomatis dan blok VirtualHost HTTPS untuk domain .dra" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Browser, Startup & Theme -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="3. Preferensi Browser, Tema &amp; Startup Windows"
                                           FontSize="15.5"
                                           FontWeight="Bold"
                                           Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Pilihan Browser" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <ComboBox ItemsSource="{Binding AvailableBrowsers}"
                                                  SelectedItem="{Binding SettingsPreferredBrowser}"
                                                  Padding="8,5" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Path Executable Browser Custom (Opsional)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsCustomBrowserPath, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Button Grid.Column="4"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih .exe..."
                                            VerticalAlignment="Bottom"
                                            Command="{Binding BrowseCustomBrowserExecutableCommand}" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="Tema Antarmuka:"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <ComboBox Width="180"
                                              ItemsSource="{Binding AvailableThemes}"
                                              SelectedItem="{Binding SettingsTheme}"
                                              Padding="8,5" />
                                </StackPanel>

                                <CheckBox IsChecked="{Binding SettingsRunOnStartup}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="13"
                                          Content="Buka DraGon secara otomatis saat Windows masuk (Tidak aktif secara default)" />
                            </StackPanel>
                        </Border>

                        <!-- Save / Reset Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="💾 Simpan"
                                    ToolTip="Simpan seluruh pengaturan DraGon"
                                    Command="{Binding SaveSettingsCommand}"
                                    Padding="10,5"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="↺ Default"
                                    ToolTip="Kembalikan nilai pengaturan ke bawaan"
                                    Padding="10,5"
                                    Command="{Binding ResetSettingsToDefaultCommand}" />
                        </StackPanel>

                        <!-- Card 4: Data Locations Info -->
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="4. Lokasi Data Aplikasi Pengguna Windows (%LocalAppData%\DraGon)"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Seluruh konfigurasi, sertifikat SSL, log, dan cadangan file hosts disimpan di dalam profil pengguna Windows Anda."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,10" />

                                <TextBlock Text="{Binding AppDataFolderDisplay, StringFormat='• Folder Data Utama:     {0}'}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,2" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ConfigFolderDisplay, StringFormat='• Folder Konfigurasi:    {0}'}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,2" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding CertsFolderDisplay, StringFormat='• Folder Sertifikat SSL: {0}'}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,2" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding LogsFolderDisplay, StringFormat='• Folder Log Proses:     {0}'}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,2" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding BackupsFolderDisplay, StringFormat='• Folder Backup Hosts:   {0}'}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,2,0,10" Foreground="{DynamicResource TextSecondaryBrush}" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="📁 Data"
                                            ToolTip="Buka folder data utama DraGon (%LocalAppData%\DraGon)"
                                            Command="{Binding OpenDraGonDataFolderCommand}"
                                            Padding="8,4"
                                            Margin="0,0,6,0" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="📁 Certs"
                                            ToolTip="Buka folder sertifikat SSL"
                                            Command="{Binding OpenCertsFolderCommand}"
                                            Padding="8,4"
                                            Margin="0,0,6,0" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="📁 Logs"
                                            ToolTip="Buka folder log proses"
                                            Command="{Binding OpenLogsFolderCommand}"
                                            Padding="8,4"
                                            Margin="0,0,6,0" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="📁 Backups"
                                            ToolTip="Buka folder cadangan file hosts Windows"
                                            Padding="8,4"
                                            Command="{Binding OpenBackupsFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Pembaruan Aplikasi (Delta / Patch Update) -->
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="5. Pembaruan Aplikasi &amp; Patch Inkremental"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Margin="0,0,10,0" />
                                            <Border Background="{DynamicResource CardAltBgBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CurrentAppVersion, StringFormat='Versi Terpasang: v{0}'}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Mendukung update kecil (Patch / Delta) yang hanya mengunduh file yang berubah tanpa mengunduh ulang seluruh aplikasi atau runtime."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                                Content="🔄 Periksa Pembaruan"
                                                ToolTip="Periksa versi rilis terbaru ke server"
                                                Command="{Binding CheckForUpdateCommand}"
                                                IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource BoolInverter}}"
                                                Padding="10,5"
                                                Margin="0,0,6,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="🧪 Demo Update Kecil"
                                                ToolTip="Uji coba simulasi update patch tanpa perlu server internet"
                                                Command="{Binding SimulateSamplePatchUpdateCommand}"
                                                Padding="8,5" />
                                    </StackPanel>
                                </Grid>

                                <!-- Status Summary Bar -->
                                <Border Background="{DynamicResource CardAltBgBrush}"
                                        CornerRadius="5"
                                        Padding="10,6"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ℹ" FontSize="13" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UpdateStatusSummary}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <!-- Details Card when Update is Available -->
                                <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource WindowBgBrush}"
                                        BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,4,0,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AvailableUpdateManifest.Title}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Margin="8,0,0,0"
                                                            Background="#103828"
                                                            BorderBrush="{DynamicResource StatusSuccessBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,1">
                                                        <TextBlock Text="{Binding AvailableUpdateManifest.FormattedPatchSize, StringFormat='✨ Ukuran Patch: {0}'}"
                                                                   FontSize="10.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="Pembaruan kecil ini HANYA mengunduh dan mengganti berkas yang diperbarui. File runtime PHP, MariaDB, Apache, Nginx, Node.js, database lokal, dan seluruh folder proyek www Anda SAMA SEKALI tidak diunduh ulang dan tetap aman."
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,4,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Apply Patch Button -->
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="⚡ Pasang Update Kecil (Patch)"
                                                    ToolTip="Unduh hanya file patch dan terapkan pembaruan langsung"
                                                    Command="{Binding DownloadAndApplyPatchUpdateCommand}"
                                                    IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource BoolInverter}}"
                                                    Padding="12,7"
                                                    VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Progress Bar if Downloading -->
                                        <StackPanel Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8">
                                            <Grid Margin="0,0,0,3">
                                                <TextBlock Text="{Binding UpdateDownloadStatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding UpdateDownloadPercent, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Grid>
                                            <ProgressBar Value="{Binding UpdateDownloadPercent}" Minimum="0" Maximum="100" Height="6" />
                                        </StackPanel>

                                        <!-- Changelog & Changed Files Details -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="230" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Catatan Rilis (Changelog):" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="4" Padding="8" MaxHeight="100">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <TextBlock Text="{Binding AvailableUpdateManifest.Changelog}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </ScrollViewer>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Berkas yang Diperbarui Saja:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <Border Background="{DynamicResource CardAltBgBrush}" CornerRadius="4" Padding="6" MaxHeight="100">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding UpdateChangedFiles}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding StringFormat='• {0}'}"
                                                                               FontFamily="Consolas"
                                                                               FontSize="10.5"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               Margin="0,1" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Settings for Auto Check -->
                                <StackPanel Margin="0,4,0,0">
                                    <CheckBox IsChecked="{Binding SettingsAutoCheckUpdates}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              FontSize="12"
                                              Content="Periksa pembaruan secara otomatis saat DraGon dibuka" />

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="URL Manifes Update (Opsional):"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Grid.Column="2"
                                                 Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsUpdateFeedUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="6,3"
                                                 FontSize="11.5"
                                                 ToolTip="Biarkan kosong untuk menggunakan server rilis resmi DraGon" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
