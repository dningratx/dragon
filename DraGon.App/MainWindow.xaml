<Window x:Class="DraGon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DraGon.Core.Models;assembly=DraGon.Core"
        mc:Ignorable="d"
        Title="DraGon (.dra)"
        Icon="pack://application:,,,/Assets/dragon-icon.ico"
        Width="680"
        Height="400"
        MinWidth="540"
        MinHeight="340"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Closing="MainWindow_OnClosing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="8,9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22"
                                Height="22"
                                CornerRadius="4"
                                Background="#09090B"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                Margin="0,0,6,0">
                            <Image Source="pack://application:,,,/Assets/dragon-icon.png"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Dra"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Gon"
                                       FontSize="14.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource CardAltBgBrush}"
                            CornerRadius="4"
                            Padding="5,2"
                            Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5"
                                     Height="5"
                                     Fill="{DynamicResource StatusSuccessBrush}"
                                     Margin="0,0,5,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HostnameSuffixBadgeText}"
                                       FontSize="9.5"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 Content="Dashboard"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Dashboard}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Dashboard" />
                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 Content="Projects"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Projects}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Projects" />
                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 Content="Services"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Services}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Services" />
                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 Content="Packages"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Packages}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Packages" />
                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}"
                                 GroupName="MainNav"
                                 Content="Settings"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualToBool}, ConverterParameter=Settings}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Settings" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Height="1"
                            Background="{DynamicResource BorderSubtleBrush}"
                            Margin="0,0,0,6" />
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Content="Terminal"
                            ToolTip="Buka PowerShell dengan environment DraGon"
                            Command="{Binding OpenGlobalTerminalCommand}"
                            Padding="6,3.5"
                            FontSize="10.5"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Style="{StaticResource GhostButtonStyle}"
                                Content="Tema"
                                ToolTip="Ganti tema gelap / terang"
                                Command="{Binding ToggleThemeQuickCommand}"
                                Padding="4,3.5"
                                FontSize="10.5" />
                        <Button Grid.Column="2"
                                Style="{StaticResource DangerButtonStyle}"
                                Content="Keluar"
                                ToolTip="Hentikan layanan dan keluar dari DraGon"
                                Click="ExitApplicationButton_OnClick"
                                Padding="4,3.5"
                                FontSize="10.5" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Content="▶ Start"
                                ToolTip="Jalankan seluruh layanan utama (Web Server, PHP-CGI, MariaDB)"
                                Padding="8,3"
                                FontSize="10.5"
                                IsEnabled="{Binding CanStartAllServices}"
                                Command="{Binding StartAllServicesCommand}"
                                Margin="0,0,4,0" />
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Content="■ Stop"
                                ToolTip="Hentikan seluruh layanan aktif"
                                Padding="8,3"
                                FontSize="10.5"
                                IsEnabled="{Binding CanStopAllServices}"
                                Command="{Binding StopAllServicesCommand}"
                                Margin="0,0,4,0" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Content="↻ Reload"
                                ToolTip="Muat ulang konfigurasi vhost dan restart layanan web"
                                Padding="6,3"
                                FontSize="10.5"
                                IsEnabled="{Binding CanReloadServices}"
                                Command="{Binding ReloadServicesCommand}"
                                Margin="0,0,2,0" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Content="Segarkan"
                                ToolTip="Periksa ulang status layanan"
                                Padding="6,3"
                                FontSize="10.5"
                                Command="{Binding RefreshAllEnvironmentStatusCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Content="PMA"
                                ToolTip="Buka phpMyAdmin di browser"
                                Padding="6,3"
                                FontSize="10.5"
                                Command="{Binding OpenPhpMyAdminInBrowserCommand}"
                                Margin="0,0,2,0" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Content="DB"
                                ToolTip="Buka HeidiSQL"
                                Padding="6,3"
                                FontSize="10.5"
                                Command="{Binding OpenHeidiSqlCommand}"
                                Margin="0,0,2,0" />
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Content="PHP Info"
                                ToolTip="Buka phpinfo() di browser"
                                Padding="6,3"
                                FontSize="10.5"
                                Command="{Binding OpenPhpInfoInBrowserCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="10,6,10,0">
                <Border Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource StatusInfoSoftBrush}"
                        BorderBrush="{DynamicResource StatusInfoBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,5"
                        Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     IsIndeterminate="True"
                                     Width="64"
                                     Height="4"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding BusyMessage}"
                                   FontWeight="Medium"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Grid>
                </Border>

                <Border Visibility="{Binding HasNotification, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{Binding NotificationTone, Converter={StaticResource NotificationToneToBrush}}"
                        BorderThickness="2,1,1,1"
                        CornerRadius="4"
                        Padding="8,5"
                        Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding NotificationTitle}"
                                       FontWeight="SemiBold"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding NotificationMessage}"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Sync Hosts"
                                    ToolTip="Sinkronkan domain proyek ke file hosts Windows"
                                    Padding="6,2.5"
                                    FontSize="10.5"
                                    Margin="0,0,4,0"
                                    Command="{Binding SyncAllDomainsToHostsCommand}" />
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Content="×"
                                    ToolTip="Tutup notifikasi"
                                    Padding="6,2"
                                    FontSize="11.5"
                                    Command="{Binding DismissNotificationCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource StatusSuccessSoftBrush}"
                        BorderBrush="{DynamicResource StatusSuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,5"
                        Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AvailableUpdateManifest.Title, FallbackValue='Pembaruan Tersedia'}"
                                           FontWeight="SemiBold"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border Margin="6,0,0,0"
                                        Background="{DynamicResource CardBgBrush}"
                                        CornerRadius="3"
                                        Padding="4,1">
                                    <TextBlock Text="{Binding AvailableUpdateManifest.FormattedPatchSize, StringFormat='Patch {0}'}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource StatusSuccessBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Hanya mengunduh berkas yang berubah tanpa mengganti runtime atau data."
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Pasang Patch"
                                    Command="{Binding DownloadAndApplyPatchUpdateCommand}"
                                    IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource BoolInverter}}"
                                    Padding="8,3"
                                    FontSize="10.5"
                                    Margin="0,0,4,0" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Detail"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Settings"
                                    Padding="7,3"
                                    FontSize="10.5"
                                    Margin="0,0,4,0" />
                            <Button Style="{StaticResource GhostButtonStyle}"
                                    Content="×"
                                    ToolTip="Tutup"
                                    Command="{Binding DismissUpdateNoticeCommand}"
                                    Padding="5,2" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="10,4,10,12">
                <Grid>

                    <!-- Dashboard -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Dashboard}">
                        <TextBlock Text="Layanan Lokal"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,2,0,6" />

                        <ItemsControl ItemsSource="{Binding InstalledServices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ServiceState}">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,6,6" Padding="10,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}" />
                                                </StackPanel>

                                                <Ellipse Grid.Column="1"
                                                         Width="7"
                                                         Height="7"
                                                         Fill="{Binding Status, Converter={StaticResource ServiceStatusToBrush}}"
                                                         ToolTip="{Binding StatusLabel}"
                                                         Margin="6,3,0,0"
                                                         VerticalAlignment="Top" />
                                            </Grid>

                                            <StackPanel Grid.Row="1" Margin="0,6,0,7">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding PortDisplay}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource StatusInfoBrush}"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding PidDisplay}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding ActiveVersionDisplay}"
                                                               Visibility="{Binding HasActiveVersion, Converter={StaticResource BoolToVis}}"
                                                               ToolTip="{Binding ActiveVersionToolTip}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource ServiceStatusToBrush}}" />
                                                </WrapPanel>

                                                <TextBlock Text="{Binding InstallationGuide}"
                                                           Visibility="{Binding IsMissingRuntime, Converter={StaticResource BoolToVis}}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource StatusWarningBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                                        Content="▶"
                                                        ToolTip="Mulai layanan"
                                                        Padding="8,2.5"
                                                        FontSize="10"
                                                        Margin="0,0,4,0"
                                                        IsEnabled="{Binding CanStart}"
                                                        Command="{Binding DataContext.StartSingleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="■"
                                                        ToolTip="Hentikan layanan"
                                                        Padding="8,2.5"
                                                        FontSize="10"
                                                        Margin="0,0,4,0"
                                                        IsEnabled="{Binding CanStop}"
                                                        Command="{Binding DataContext.StopSingleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Content="Folder"
                                                        ToolTip="Buka folder runtime layanan"
                                                        Padding="6,2.5"
                                                        FontSize="10.5"
                                                        Command="{Binding DataContext.OpenServiceRuntimeFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Projects -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Projects}">
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Proyek &amp; Domain"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="+ Proyek"
                                        ToolTip="Buat proyek baru (Standar, Laravel, WordPress, Git)"
                                        Padding="8,3"
                                        FontSize="11"
                                        Command="{Binding OpenAddProjectFormCommand}"
                                        Margin="0,0,4,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Impor"
                                        ToolTip="Pilih folder proyek lokal yang sudah ada"
                                        Padding="7,3"
                                        FontSize="11"
                                        Command="{Binding BrowseAndAddProjectCommand}"
                                        Margin="0,0,4,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Pindai"
                                        ToolTip="Pindai folder workspace DraGon"
                                        Padding="7,3"
                                        FontSize="11"
                                        Command="{Binding ScanWorkspaceForProjectsCommand}"
                                        Margin="0,0,4,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Hosts"
                                        ToolTip="Sinkronkan domain proyek ke hosts Windows"
                                        Padding="7,3"
                                        FontSize="11"
                                        Command="{Binding SyncAllDomainsToHostsCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="8,5"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding RootCaStatusText}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource StatusSuccessBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Content="Trust CA"
                                            ToolTip="Pasang DraGon Root CA di Windows Certificate Store"
                                            Padding="6,2.5"
                                            FontSize="10.5"
                                            Margin="0,0,2,0"
                                            Command="{Binding TrustRootCaCommand}" />
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Content="Perbarui SSL"
                                            ToolTip="Terbitkan ulang sertifikat SSL proyek"
                                            Padding="6,2.5"
                                            FontSize="10.5"
                                            Margin="0,0,2,0"
                                            Command="{Binding RegenerateAllSslCertificatesCommand}" />
                                    <Button Style="{StaticResource GhostButtonStyle}"
                                            Content="Certs"
                                            ToolTip="Buka folder sertifikat SSL"
                                            Padding="6,2.5"
                                            FontSize="10.5"
                                            Command="{Binding OpenCertsFolderCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding IsProjectFormOpen, Converter={StaticResource BoolToVis}}"
                                BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Proyek &amp; Domain Lokal"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="×"
                                            ToolTip="Tutup formulir"
                                            Padding="5,1"
                                            Command="{Binding CancelProjectFormCommand}" />
                                </Grid>

                                <Border Background="{DynamicResource CardAltBgBrush}"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding IsEditingExistingProject, Converter={StaticResource InverseBoolToVis}}">
                                    <WrapPanel>
                                        <RadioButton Content="Standar"
                                                     GroupName="NewProjType"
                                                     IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=Standard}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     FontSize="11"
                                                     Margin="0,0,12,2" />
                                        <RadioButton Content="Laravel"
                                                     GroupName="NewProjType"
                                                     IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=Laravel}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     FontSize="11"
                                                     Margin="0,0,12,2" />
                                        <RadioButton Content="WordPress"
                                                     GroupName="NewProjType"
                                                     IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=WordPress}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     FontSize="11"
                                                     Margin="0,0,12,2" />
                                        <RadioButton Content="Git Clone"
                                                     GroupName="NewProjType"
                                                     IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=GitClone}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     FontSize="11"
                                                     Margin="0,0,12,2" />
                                        <RadioButton Content="Folder Ada"
                                                     GroupName="NewProjType"
                                                     IsChecked="{Binding FormProjectType, Converter={StaticResource StringEqualToBool}, ConverterParameter=Existing}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     FontSize="11"
                                                     Margin="0,0,4,2" />
                                    </WrapPanel>
                                </Border>

                                <StackPanel Visibility="{Binding FormProjectType, Converter={StaticResource StringEqualToVis}, ConverterParameter=GitClone}"
                                            Margin="0,0,0,7">
                                    <TextBlock Text="URL Repositori Git" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding FormGitUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="https://github.com/username/repository.git" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Nama Proyek" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding FormProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding FormDomainLabelText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding FormProjectDomain, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Folder Proyek" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding FormProjectFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih..."
                                            Command="{Binding BrowseProjectFolderForFormCommand}" />
                                </Grid>

                                <TextBlock Text="{Binding FormDetectedFrameworkHint}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource StatusInfoBrush}"
                                           Margin="0,5,0,6" />

                                <CheckBox IsChecked="{Binding FormEnableHttps}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="11"
                                          Margin="0,0,0,4"
                                          Content="Aktifkan HTTPS lokal dan sertifikat SSL otomatis" />
                                <CheckBox IsChecked="{Binding FormAutoSyncHosts}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="11"
                                          Margin="0,0,0,9"
                                          Content="Sinkronkan domain ke file hosts Windows (127.0.0.1)" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            Content="{Binding SaveProjectButtonText}"
                                            Command="{Binding SaveProjectFormCommand}"
                                            Padding="10,4"
                                            Margin="0,0,6,0" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Batal"
                                            Command="{Binding CancelProjectFormCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                 Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Cari proyek atau domain..."
                                 Width="260"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,8" />

                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding HasFilteredProjects, Converter={StaticResource InverseBoolToVis}}"
                                Padding="18">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="400">
                                <TextBlock Text="Belum ada proyek"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Buat proyek baru, impor folder lokal, atau pindai workspace."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,10" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="+ Buat Proyek"
                                        HorizontalAlignment="Center"
                                        Command="{Binding OpenAddProjectFormCommand}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FilteredProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ProjectItem}">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6" Padding="10,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,2" />
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="3"
                                                            Padding="5,1.5"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,5,2">
                                                        <TextBlock Text="{Binding FrameworkBadgeText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="3"
                                                            Padding="5,1.5"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,5,2">
                                                        <TextBlock Text="{Binding ProtocolBadgeText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}" />
                                                    </Border>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,2">
                                                        <Ellipse Width="6"
                                                                 Height="6"
                                                                 Fill="{Binding DomainStatus, Converter={StaticResource DomainStatusToBrush}}"
                                                                 Margin="0,0,4,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DomainStatusText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </WrapPanel>

                                                <Button Grid.Column="1"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Content="Buka"
                                                        ToolTip="Buka domain proyek di browser"
                                                        Padding="9,3"
                                                        FontSize="10.5"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.OpenProjectInBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>

                                            <Grid Margin="0,5,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding PrimaryUrlDisplay}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StatusInfoBrush}"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding SslStatusText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding DocumentRoot, StringFormat='Root: {0}'}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding FolderPath}"
                                                               FontSize="10"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="{Binding TunnelButtonText}"
                                                            ToolTip="{Binding TunnelButtonTooltip}"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,3,0"
                                                            Command="{Binding DataContext.ToggleProjectTunnelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="HTTPS"
                                                            ToolTip="Beralih HTTPS / HTTP"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,2,0"
                                                            Command="{Binding DataContext.ToggleProjectHttpsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Term"
                                                            ToolTip="Buka terminal di folder proyek"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,2,0"
                                                            Command="{Binding DataContext.OpenProjectInTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Folder"
                                                            ToolTip="Buka folder proyek di Explorer"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,2,0"
                                                            Command="{Binding DataContext.OpenProjectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Edit"
                                                            ToolTip="Ubah konfigurasi proyek"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,2,0"
                                                            Command="{Binding DataContext.OpenEditProjectFormCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource DangerButtonStyle}"
                                                            Content="Hapus"
                                                            ToolTip="Hapus proyek dari daftar"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Command="{Binding DataContext.RemoveProjectFromListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Visibility="{Binding HasPublicTunnelUrl, Converter={StaticResource BoolToVis}}"
                                                    Background="{DynamicResource CardAltBgBrush}"
                                                    BorderBrush="{DynamicResource StatusSuccessBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,4"
                                                    Margin="0,6,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Tunnel:"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}"
                                                                   Margin="0,0,5,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Text="{Binding PublicTunnelUrl, Mode=OneWay}"
                                                                 IsReadOnly="True"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 FontFamily="Cascadia Mono, Consolas"
                                                                 FontSize="10.5"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="Salin"
                                                                Padding="6,2"
                                                                FontSize="10"
                                                                Margin="4,0,3,0"
                                                                Command="{Binding DataContext.CopyTunnelUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="Buka"
                                                                Padding="6,2"
                                                                FontSize="10"
                                                                Command="{Binding DataContext.OpenTunnelUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Services -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Services}">
                        <TextBlock Text="Layanan &amp; Versi Runtime"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,8" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="PHP"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Content="Paket"
                                                ToolTip="Unduh versi PHP lain di menu Packages"
                                                Padding="5,1.5"
                                                FontSize="10"
                                                Command="{Binding SelectSectionCommand}"
                                                CommandParameter="Packages" />
                                    </Grid>
                                    <TextBlock Text="{Binding ActivePhpSummaryText}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{DynamicResource StatusInfoBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding PhpVersions}"
                                                  SelectedItem="{Binding SelectedPhpVersionCandidate}"
                                                  FontSize="11"
                                                  Padding="5,3"
                                                  Margin="0,0,4,0" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Terapkan"
                                                Padding="8,3"
                                                FontSize="10.5"
                                                Command="{Binding ApplySelectedPhpVersionCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Database"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="Init"
                                                    ToolTip="Inisialisasi direktori data database"
                                                    Padding="5,1.5"
                                                    FontSize="10"
                                                    Margin="0,0,2,0"
                                                    Command="{Binding InitializeMariaDbDatabaseCommand}" />
                                            <Button Style="{StaticResource GhostButtonStyle}"
                                                    Content="Paket"
                                                    ToolTip="Unduh versi Database lain di menu Packages"
                                                    Padding="5,1.5"
                                                    FontSize="10"
                                                    Command="{Binding SelectSectionCommand}"
                                                    CommandParameter="Packages" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding ActiveDatabaseSummaryText}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{DynamicResource StatusSuccessBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding DatabaseVersions}"
                                                  SelectedItem="{Binding SelectedDatabaseVersionCandidate}"
                                                  FontSize="11"
                                                  Padding="5,3"
                                                  Margin="0,0,4,0" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Terapkan"
                                                Padding="8,3"
                                                FontSize="10.5"
                                                Command="{Binding ApplySelectedDatabaseVersionCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Ekstensi PHP (php.ini)"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Preset Laravel"
                                                Padding="7,2.5"
                                                FontSize="10.5"
                                                Margin="0,0,4,0"
                                                Command="{Binding EnableRecommendedPhpExtensionsCommand}" />
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Content="php.ini"
                                                Padding="6,2.5"
                                                FontSize="10.5"
                                                Margin="0,0,2,0"
                                                Command="{Binding OpenActivePhpIniFileCommand}" />
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Content="Folder ext"
                                                Padding="6,2.5"
                                                FontSize="10.5"
                                                Command="{Binding OpenActivePhpExtFolderCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource CardAltBgBrush}"
                                        CornerRadius="4"
                                        Padding="8,6">
                                    <ItemsControl ItemsSource="{Binding PhpExtensions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:PhpExtensionItem}">
                                                <CheckBox Content="{Binding DisplayLabel}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          FontFamily="Cascadia Mono, Consolas"
                                                          FontSize="10.5"
                                                          Margin="2,2.5"
                                                          Cursor="Hand"
                                                          Command="{Binding DataContext.TogglePhpExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding InstalledServices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ServiceState}">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6" Padding="10,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <Ellipse Width="7"
                                                                 Height="7"
                                                                 Fill="{Binding Status, Converter={StaticResource ServiceStatusToBrush}}"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding PortDisplay}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource StatusInfoBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding PidDisplay}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding ActiveVersionDisplay}"
                                                                   Visibility="{Binding HasActiveVersion, Converter={StaticResource BoolToVis}}"
                                                                   ToolTip="{Binding ActiveVersionToolTip}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Status, Converter={StaticResource ServiceStatusToBrush}}"
                                                                   VerticalAlignment="Center" />
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding StatusMessage}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,3,0,0" />

                                                    <TextBlock Text="{Binding InstallationGuide}"
                                                               Visibility="{Binding IsMissingRuntime, Converter={StaticResource BoolToVis}}"
                                                               FontSize="10.5"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource StatusWarningBrush}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                                            Content="▶"
                                                            ToolTip="Mulai layanan"
                                                            Padding="8,2.5"
                                                            FontSize="10"
                                                            Margin="0,0,3,0"
                                                            IsEnabled="{Binding CanStart}"
                                                            Command="{Binding DataContext.StartSingleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="■"
                                                            ToolTip="Hentikan layanan"
                                                            Padding="8,2.5"
                                                            FontSize="10"
                                                            Margin="0,0,3,0"
                                                            IsEnabled="{Binding CanStop}"
                                                            Command="{Binding DataContext.StopSingleServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Folder"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,2,0"
                                                            Command="{Binding DataContext.OpenServiceRuntimeFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Log"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Command="{Binding DataContext.OpenServiceLogFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding ExecutablePath, TargetNullValue='Executable: belum terdeteksi', StringFormat='Bin: {0}'}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,2,0,0" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Log Aktivitas"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Content="dragon.log"
                                                Padding="6,2"
                                                FontSize="10.5"
                                                Command="{Binding OpenMainLogFileCommand}"
                                                Margin="0,0,2,0" />
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Content="Folder"
                                                Padding="6,2"
                                                FontSize="10.5"
                                                Command="{Binding OpenLogsFolderCommand}"
                                                Margin="0,0,2,0" />
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Content="Bersihkan"
                                                Padding="6,2"
                                                FontSize="10.5"
                                                Command="{Binding ClearLogViewCommand}" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource TerminalBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Height="145"
                                        Padding="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ApplicationLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="10.5"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TerminalTextBrush}"
                                                               Margin="0,1" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Packages -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Packages}">
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Paket Runtime"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="↻ Pindai"
                                        ToolTip="Pindai ulang runtime terpasang"
                                        Padding="8,3"
                                        FontSize="11"
                                        Command="{Binding RescanRuntimesCommand}"
                                        Margin="0,0,4,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Folder Runtime"
                                        Padding="7,3"
                                        FontSize="11"
                                        Command="{Binding OpenRuntimeBaseFolderCommand}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RuntimePackages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:RuntimePackageInfo}">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,6" Padding="10,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,7,2" />
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="3"
                                                            Padding="5,1"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,5,2">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource CardAltBgBrush}"
                                                            CornerRadius="3"
                                                            Padding="5,1"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,2">
                                                        <TextBlock Text="{Binding StatusBadgeText}"
                                                                   FontSize="10"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}" />
                                                    </Border>
                                                </WrapPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                                            Content="{Binding DownloadButtonText}"
                                                            ToolTip="{Binding DownloadButtonToolTip}"
                                                            Padding="8,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,4,0"
                                                            IsEnabled="{Binding CanDownloadAndInstall}"
                                                            Visibility="{Binding HasDirectArchiveUrl, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.DownloadAndInstallPackageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                                            Content="Buka"
                                                            ToolTip="Buka HeidiSQL"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,4,0"
                                                            Visibility="{Binding Id, Converter={StaticResource StringEqualToVis}, ConverterParameter=heidisql}"
                                                            IsEnabled="{Binding IsAvailable}"
                                                            Command="{Binding DataContext.OpenHeidiSqlCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Impor ZIP"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,2,0"
                                                            IsEnabled="{Binding CanInstallOrImport}"
                                                            Command="{Binding DataContext.ImportPackageZipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Web"
                                                            ToolTip="{Binding WebsiteOrUpdateActionToolTip}"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Margin="0,0,2,0"
                                                            Command="{Binding DataContext.OpenPackageDownloadPageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource GhostButtonStyle}"
                                                            Content="Folder"
                                                            Padding="6,2.5"
                                                            FontSize="10.5"
                                                            Command="{Binding DataContext.OpenPackageTargetFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="{Binding InstallInstructions}"
                                                       FontSize="10.5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,4,0,4" />

                                            <Border Background="{DynamicResource CardAltBgBrush}"
                                                    CornerRadius="4"
                                                    Padding="7,4"
                                                    Margin="0,0,0,5"
                                                    Visibility="{Binding HasMultipleVersions, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="Versi:"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0" />
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding AvailableVersions}"
                                                              SelectedItem="{Binding SelectedDownloadVersion, Mode=TwoWay}"
                                                              DisplayMemberPath="DisplayName"
                                                              FontSize="10.5"
                                                              Height="23"
                                                              VerticalContentAlignment="Center"
                                                              Margin="0,0,6,0" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Visibility="{Binding IsSelectedVersionInstalled, Converter={StaticResource BoolToVis}}"
                                                                   Text="Terpasang"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource StatusSuccessBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Button Visibility="{Binding IsSelectedVersionInstalled, Converter={StaticResource InverseBoolToVis}}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Content="Pasang"
                                                                Padding="7,2"
                                                                FontSize="10"
                                                                IsEnabled="{Binding CanInstallOrImport}"
                                                                Command="{Binding DataContext.DownloadAndInstallPackageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <WrapPanel>
                                                <TextBlock Text="{Binding RecommendedVersion, StringFormat='Rekomendasi: {0}'}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding License, StringFormat='Lisensi: {0}'}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding DetectedVersion, StringFormat='Aktif: {0}'}"
                                                           Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource StatusSuccessBrush}" />
                                            </WrapPanel>

                                            <TextBlock Text="{Binding TargetRuntimeFolder}"
                                                       FontSize="10"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />

                                            <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,6,0,0">
                                                <ProgressBar Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding InstallProgressPercent}"
                                                             Height="5"
                                                             Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding InstallStatusMessage}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource StatusInfoBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Settings -->
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource StringEqualToVis}, ConverterParameter=Settings}">
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Pengaturan"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Simpan"
                                        Command="{Binding SaveSettingsCommand}"
                                        Padding="10,3"
                                        FontSize="11"
                                        Margin="0,0,4,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Default"
                                        Command="{Binding ResetSettingsToDefaultCommand}"
                                        Padding="8,3"
                                        FontSize="11" />
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Folder &amp; Path"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />

                                <TextBlock Text="Folder Aplikasi" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding SettingsApplicationFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih..."
                                            Command="{Binding BrowseApplicationFolderCommand}" />
                                    <Button Grid.Column="4"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="Buka"
                                            Command="{Binding OpenApplicationFolderCommand}" />
                                </Grid>

                                <TextBlock Text="Workspace Proyek" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding SettingsWorkspacePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih..."
                                            Command="{Binding BrowseWorkspaceFolderCommand}" />
                                    <Button Grid.Column="4"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="Buka"
                                            Command="{Binding OpenWorkspaceFolderCommand}" />
                                </Grid>

                                <TextBlock Text="Folder Induk Runtime" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding SettingsRuntimeBasePath, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih..."
                                            Command="{Binding BrowseRuntimeFolderCommand}" />
                                    <Button Grid.Column="4"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="Buka"
                                            Command="{Binding OpenRuntimeBaseFolderCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Web Server, Domain &amp; Port"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Akhiran Domain (TLD)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsHostnameSuffix, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Default: .dra (contoh: .dra, .test, .local)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Web Server Utama" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding AvailableWebServers}"
                                                  SelectedItem="{Binding SettingsPreferredWebServer}"
                                                  FontSize="11"
                                                  Padding="5,3.5" />
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,6,6">
                                        <TextBlock Text="Nginx HTTP" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SettingsWebServerPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,6">
                                        <TextBlock Text="Nginx HTTPS" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SettingsWebServerHttpsPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="PHP FastCGI" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SettingsPhpCgiPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Apache HTTP" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SettingsApachePort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Apache HTTPS" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SettingsApacheHttpsPort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="MariaDB / MySQL" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SettingsDatabasePort, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>

                                <CheckBox IsChecked="{Binding SettingsEnableLocalHttps}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="11"
                                          Content="Otomatis buat sertifikat SSL lokal dan VirtualHost HTTPS" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="Browser, Tema &amp; Startup"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6" />

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Browser" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding AvailableBrowsers}"
                                                  SelectedItem="{Binding SettingsPreferredBrowser}"
                                                  FontSize="11"
                                                  Padding="5,3.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Custom Browser (.exe)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                                 Text="{Binding SettingsCustomBrowserPath, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <Button Grid.Column="4"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Pilih..."
                                            VerticalAlignment="Bottom"
                                            Command="{Binding BrowseCustomBrowserExecutableCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tema" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <ComboBox ItemsSource="{Binding AvailableThemes}"
                                                  SelectedItem="{Binding SettingsTheme}"
                                                  FontSize="11"
                                                  Padding="5,3.5" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2"
                                              IsChecked="{Binding SettingsRunOnStartup}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              FontSize="11"
                                              VerticalAlignment="Bottom"
                                              Margin="0,0,0,4"
                                              Content="Jalankan saat Windows masuk" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Data Aplikasi"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="Data" Padding="5,2" FontSize="10.5" Command="{Binding OpenDraGonDataFolderCommand}" Margin="0,0,2,0" />
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="Certs" Padding="5,2" FontSize="10.5" Command="{Binding OpenCertsFolderCommand}" Margin="0,0,2,0" />
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="Logs" Padding="5,2" FontSize="10.5" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,2,0" />
                                        <Button Style="{StaticResource GhostButtonStyle}" Content="Backups" Padding="5,2" FontSize="10.5" Command="{Binding OpenBackupsFolderCommand}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding AppDataFolderDisplay, StringFormat='Data:    {0}'}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ConfigFolderDisplay, StringFormat='Config:  {0}'}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CertsFolderDisplay, StringFormat='Certs:   {0}'}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LogsFolderDisplay, StringFormat='Logs:    {0}'}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding BackupsFolderDisplay, StringFormat='Backups: {0}'}" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Pembaruan"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,8,0" />
                                        <Border Background="{DynamicResource CardAltBgBrush}"
                                                CornerRadius="3"
                                                Padding="5,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CurrentAppVersion, StringFormat='v{0}'}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Content="Periksa Pembaruan"
                                            Command="{Binding CheckForUpdateCommand}"
                                            IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource BoolInverter}}"
                                            Padding="8,3"
                                            FontSize="10.5" />
                                </Grid>

                                <TextBlock Text="{Binding UpdateStatusSummary}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6" />

                                <Border Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource CardAltBgBrush}"
                                        BorderBrush="{DynamicResource AccentPrimaryBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,6"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AvailableUpdateManifest.Title}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding AvailableUpdateManifest.FormattedPatchSize, StringFormat=' ({0})'}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource StatusSuccessBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Content="Pasang Patch"
                                                    Command="{Binding DownloadAndApplyPatchUpdateCommand}"
                                                    IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource BoolInverter}}"
                                                    Padding="8,3"
                                                    FontSize="10.5" />
                                        </Grid>

                                        <StackPanel Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="{Binding UpdateDownloadStatusText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding UpdateDownloadPercent, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Grid>
                                            <ProgressBar Value="{Binding UpdateDownloadPercent}" Minimum="0" Maximum="100" Height="4" />
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="180" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" CornerRadius="3" Padding="6" MaxHeight="80">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <TextBlock Text="{Binding AvailableUpdateManifest.Changelog}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </ScrollViewer>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" CornerRadius="3" Padding="6" MaxHeight="80">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding UpdateChangedFiles}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           FontFamily="Cascadia Mono, Consolas"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           Margin="0,1" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <CheckBox IsChecked="{Binding SettingsAutoCheckUpdates}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          FontSize="11"
                                          Content="Periksa pembaruan otomatis saat dibuka"
                                          Margin="0,0,0,5" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Feed URL:"
                                               FontSize="10.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="2"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Text="{Binding SettingsUpdateFeedUrl, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="10.5"
                                             Padding="6,3"
                                             ToolTip="Kosongkan untuk menggunakan server rilis resmi DraGon" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
